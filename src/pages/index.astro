---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PostList from '../components/PostList.astro';
import { categoryUrl, categoriesFrom, getPosts, urlFor } from '../lib/posts';
const posts = await getPosts();
const categories = categoriesFrom(posts);
const palette = ['#58eaff', '#9a6cff', '#76e8bd', '#ff315e', '#f6b85c'];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<SiteLayout>
<main id="home">
    <section class="cx-hero cx-frame">
      <div class="cx-frame__trace" aria-hidden="true"></div>

      <div class="cx-hero__copy">
        <p class="cx-kicker">COREXLYTH // DIGITAL FRONTIER</p>
        <h1>Keşfedilecek yeni şeyler var.</h1>
        <p class="cx-lead">Teknolojinin gölgelerinde keşfeder, dijital dünyanın derinliklerinde yol açarız.</p>

        <form class="cx-search-form cx-home-search" role="search" action={urlFor('ara/')} method="get">
          <label for="cx-home-query">Yazılarda ara</label>
          <div class="cx-search-form__row">
            <input id="cx-home-query" name="q" type="search" placeholder="Android, uygulama, rehber…" minlength="2" maxlength="100" required />
            <button type="submit">ARA ↗</button>
          </div>
        </form>
        <div class="cx-home-meta">
          <span><i class="cx-live-dot"></i>SIGNAL ACTIVE</span>
          <span>CHANNELS // {String(categories.length).padStart(2,"0")}</span>
          <span>NETWORK // PUBLIC</span>
        </div>
      </div>

      <aside class="cx-terminal cx-frame cx-frame--compact">
        <div class="cx-terminal__top">
          <span>SYSTEM // STATUS</span>
          <i></i>
        </div>
        <dl>
          <div><dt>HOST</dt><dd>GITHUB PAGES</dd></div>
          <div><dt>CORE</dt><dd>ONLINE</dd></div>
          <div><dt>THEME</dt><dd>CX MODE</dd></div>
          <div><dt>LATENCY</dt><dd>NOMINAL</dd></div>
        </dl>
      </aside>
    </section>


<section class="cx-discovery" id="kanallar">
 <div class="cx-discovery-title"><p class="cx-kicker">CHANNEL INDEX // AUTO</p><h2>KEŞİF<br />ALANLARI</h2></div>
 {categories.map((category,i) => {
    const entries=posts.filter(post => post.data.category===category);
    const accent=palette[i%palette.length];
    return <article class="cx-category-panel cx-hud-frame" style={`--cx-accent:${accent}`}>
      <div class="cx-hud-notch" aria-hidden="true"></div>
      <header class="cx-category-panel__head">
        <div><div class="cx-category-panel__title-row">
          <h3>{category.toLocaleUpperCase('tr-TR')}</h3><span>{entries.length} YAYIN</span><em>// AUTO</em>
        </div><p>“{category}” kanalından en yeni kayıtlar.</p><b>ADAPTİF KANAL</b></div>
        <a class="cx-explore-btn" href={categoryUrl(category)}>KEŞFET <span>→</span></a>
      </header>
      <div class="cx-panel-carousel" tabindex="0" aria-label={`${category} içerikleri`}>
        {entries.map(entry => <ArticleCard post={entry} accent={accent} />)}
      </div>
    </article>;
 })}
</section>
<section class="cx-all-records cx-hud-frame" id="kayitlar">
 <div class="cx-hud-notch" aria-hidden="true"></div>
 <header class="cx-records-head">
  <div class="cx-records-title"><h2>TÜM KAYITLAR</h2><span>{posts.length} YAYIN</span></div>
  <p>Ne var ne yok, sisteme düşen her şey burada. Yeni yayınlardan başlayan gerçek içerik akışı.</p>
  <a class="cx-expand-btn cx-expand-link" href={urlFor('arsiv/')}>TÜM ARŞİVİ AÇ <span>→</span></a>
 </header>
 <PostList posts={posts.slice(0,5)} />
</section>
    <section class="cx-info-grid" id="hakkinda">
      <article class="cx-info cx-frame">
        <p class="cx-kicker">ABOUT // CORE</p>
        <h2>CoreXLyth nedir?</h2>
        <p>Teknoloji, uygulamalar, pratik rehberler, deneyler ve dijital dünyadan seçilmiş kayıtların tutulduğu bağımsız bir keşif alanı.</p>
      </article>
      <article class="cx-info cx-frame cx-info--signal">
        <p class="cx-kicker">NETWORK // STATUS</p>
        <ul>
          <li><span>Frontend</span><b>ACTIVE</b></li>
          <li><span>Animations</span><b>ACTIVE</b></li>
          <li><span>Database</span><b>TEST</b></li>
          <li><span>Auth</span><b>TEST</b></li>
        </ul>
      </article>
    </section>

</main>
</SiteLayout>
