---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Community from '../../components/Community.astro';
import { categoryUrl, coverFor, dateTR, getPosts, postUrl, tagUrl, urlFor } from '../../lib/posts';
import type { Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const titleWords = post.data.title.trim().split(/\s+/);
const titleEnding = titleWords.length > 1 ? titleWords.pop() : '';
const titleStart = titleWords.join(' ');
const { Content, headings } = await render(post);
const contents = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const related = (await getPosts()).filter(p => p.id !== post.id && (p.data.category === post.data.category || p.data.tags.some(t => post.data.tags.includes(t)))).slice(0,3);
const coverAbsolute = new URL(coverFor(post), Astro.site ?? Astro.url).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  inLanguage: 'tr-TR',
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  image: coverAbsolute,
  mainEntityOfPage: new URL(postUrl(post), Astro.site ?? Astro.url).href,
  author: { '@type': 'Organization', name: 'CoreXLyth' },
  publisher: { '@type': 'Organization', name: 'CoreXLyth', url: 'https://corexlyth.github.io/corexlyth-site/' },
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
};
---
<SiteLayout
  title={`${post.data.title} | CoreXLyth`}
  description={post.data.description}
  image={coverAbsolute}
  article={true}
  publishedTime={post.data.pubDate.toISOString()}
  structuredData={structuredData}
>
  {post.data.publicationRevision && <meta slot="head" name="cx-publication" content={`${post.id}:${post.data.publicationRevision}`} />}
  <div class="cx-reading-progress" aria-hidden="true"><span></span></div>
  <main id="home" class="cx-reading-shell">
    <article class="cx-article cx-hud-frame" data-pagefind-body>
      <nav class="cx-breadcrumb" aria-label="İçerik yolu" data-pagefind-ignore>
        <a href={urlFor('')}>Ana Sayfa</a><span>›</span>
        <a href={urlFor('#kanallar')}>Kategoriler</a><span>›</span>
        <a href={categoryUrl(post.data.category)}>{post.data.category}</a><span>›</span>
        <span aria-current="page">{post.data.title}</span>
      </nav>
      {(contents.length >= 2 || post.data.tags.length > 0) && <div class="cx-article__sidebar" data-pagefind-ignore>
      {contents.length >= 2 && <details class="cx-toc" open data-pagefind-ignore>
        <summary>İçindekiler</summary>
        <nav aria-label="Yazının içindekileri">
          <ol>
            {contents.map(heading => <li class:list={{ 'cx-toc__sub': heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>)}
          </ol>
        </nav>
      </details>}

      {post.data.tags.length > 0 && <aside class="cx-article__topics" aria-label="Bu yazının konusu" data-pagefind-ignore>
        <h2>Bu yazının konusu</h2>
        <div class="cx-tag-links">
          {post.data.tags.map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}
        </div>
      </aside>}
      </div>}

      <div class="cx-article__intro">
      <header class="cx-article__head">
        <a class="cx-article__category" href={categoryUrl(post.data.category)}>{post.data.category}</a>
        <h1>{titleStart}{titleEnding && <> <span>{titleEnding}</span></>}</h1>
        <p class="cx-article__summary">{post.data.description}</p>
        <div class="cx-article__meta">
          <time datetime={post.data.pubDate.toISOString().slice(0,10)}>{dateTR(post.data.pubDate)}</time>
          <a href={categoryUrl(post.data.category)}>{post.data.category}</a>
        </div>
      </header>

      <figure class="cx-article-cover">
        <img src={coverFor(post)} alt={post.data.coverAlt} loading="eager" />
      </figure>
      </div>

      <div class="cx-article__content">
        <Content />
      </div>

      <footer class="cx-article__foot">
        <a class="cx-link" href={urlFor('arsiv/')}>← TÜM KAYITLARA DÖN</a>
      </footer>

      {related.length > 0 && <section class="cx-article__related" aria-label="Benzer içerikler" data-pagefind-ignore>
        <h2>İlgili Yazılar</h2>
        <div class="cx-article__related-list">
          {related.map(item => <a class="cx-article__related-card" href={postUrl(item)}>
            <img src={coverFor(item)} alt="" loading="lazy" />
            <span><small>{item.data.category}</small><strong>{item.data.title}</strong></span>
          </a>)}
        </div>
      </section>}
    </article>

    <Community post={post.id} />

  </main>
</SiteLayout>
