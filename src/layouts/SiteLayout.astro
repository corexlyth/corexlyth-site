---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'CoreXLyth — Dijital keşif alanı',
  description = 'CoreXLyth: teknoloji, Android uygulamaları, rehberler, tarih ve dijital dünyanın derinliklerinden içerikler.',
  noindex = false,
} = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050812" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="stylesheet" href={`${base}assets/css/main.css?v=20261025-4`} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script is:inline src={`${base}assets/js/main.js?v=20261025-4`}></script>
  </body>
</html>
