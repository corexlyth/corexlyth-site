---
import { authConfigured } from '../config/auth';
interface Props { title?: string; description?: string; noindex?: boolean; image?: string; article?: boolean; publishedTime?: string; structuredData?: Record<string, unknown>; }
const { title = 'CoreXLyth — Dijital keşif alanı',
description = 'CoreXLyth: teknoloji, Android uygulamaları, rehberler ve dijital dünyadan bağımsız yayınlar.',
noindex = false, image, article = false, publishedTime, structuredData } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#050812" />
<meta name="description" content={description} />
<title>{title}</title>
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="CoreXLyth RSS" href={`${base}rss.xml`} />
<link rel="sitemap" type="application/xml" href={`${base}sitemap-index.xml`} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:locale" content="tr_TR" />
<meta property="og:site_name" content="CoreXLyth" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{image && <meta property="og:image" content={image} />}
{article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
<link rel="stylesheet" href={`${base}assets/css/main.css?v=city-depth-1`} />
<noscript><style is:inline>.cx-boot{display:none!important}@media(max-width:700px){.cx-menu-button{display:none!important}.cx-nav{display:flex!important;position:static!important;box-shadow:none!important}.cx-header__inner{flex-wrap:wrap}.cx-nav{width:100%}}</style></noscript>
<slot name="head" />
</head>
<body>
<a class="cx-skip-link" href="#home">Ana içeriğe geç</a>
  <div class="cx-boot" aria-hidden="true">
    <div class="cx-boot__core">
      <span class="cx-boot__kicker">COREXLYTH // BOOT</span>
      <strong class="cx-boot__logo" data-text="CoreXLyth">CoreXLyth</strong>
      <span class="cx-boot__bar"><i></i></span>
    </div>
  </div>

  <div class="cx-ambient" aria-hidden="true">
    <i class="cx-ambient__orb cx-ambient__orb--a"></i>
    <i class="cx-ambient__orb cx-ambient__orb--b"></i>
    <i class="cx-ambient__grid"></i>
    <div class="cx-ambient__depth" data-signal-depth><i class="cx-ambient__halo"></i><i class="cx-ambient__circuit cx-ambient__circuit--a"></i><i class="cx-ambient__circuit cx-ambient__circuit--b"></i><i class="cx-ambient__stars"></i></div>
    <canvas class="cx-depth-city" data-depth-city aria-hidden="true"></canvas>
    <div class="cx-cyberworld" data-cyberworld>
      <div class="cx-cyberworld__sky"></div>
      <svg class="cx-cyberworld__city" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMax slice" aria-hidden="true"><defs><linearGradient id="cityLight" x2="0" y2="1"><stop stop-color="#215878"/><stop offset="1" stop-color="#080d1d"/></linearGradient><pattern id="cityWindows" width="22" height="28" patternUnits="userSpaceOnUse"><path d="M4 4h3v8H4zm10 1h2v5h-2z" fill="#5eefff" opacity=".45"/></pattern></defs><g fill="url(#cityLight)" stroke="#68dff5" stroke-opacity=".35"><path d="M0 700V260h75V145h60v115h55v440zM195 700V230h52v-85h50v85h70v470zM375 700V190h45V60h80v130h58v510zM570 700V310h55V155h55v155h48v390zM742 700V210h50V85h66v125h55v490zM920 700V280h55V155h70v125h65v420zM1110 700V215h55V90h35v610z"/></g><path fill="url(#cityWindows)" d="M0 260h190v440H0zm195-30h172v470H195zm180-40h183v510H375zm195 120h158v390H570zm172-100h171v490H742zm178 70h190v420H920zm190-65h90v485h-90z"/></svg>
      <div class="cx-cyberworld__grid"></div><div class="cx-cyberworld__stream cx-cyberworld__stream--one"></div><div class="cx-cyberworld__stream cx-cyberworld__stream--two"></div>
    </div>
    <i class="cx-ambient__scan"></i>
  </div>

  <header class="cx-header">
    <div class="cx-header__inner">
      <a class="cx-brand" href={base} aria-label="CoreXLyth ana sayfa">
        <span class="cx-brand__node">NODE://CX</span>
        <span class="cx-brand__name" data-text="CoreXLyth">CoreXLyth</span>
        <span class="cx-brand__dot" aria-hidden="true"></span>
      </a>

      <button class="cx-menu-button" type="button" aria-expanded="false" aria-controls="cx-nav" aria-label="Ana menüyü aç veya kapat">
        <span class="cx-menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
        <b>MENÜ</b>
      </button>

      <nav class="cx-nav" id="cx-nav" aria-label="Ana menü">
        <a href={base}>Ana sayfa</a>
        <a href={`${base}arsiv/`}>Yazılar</a>
        <a href={`${base}ara/`}>⌕ Ara</a>
        <a href={`${base}#kanallar`}>Kanallar</a>
        <a href={`${base}#hakkinda`}>Hakkında</a>
        {authConfigured && <>
          <a data-nav-guest href={`${base}hesap/giris/`}>Giriş yap</a>
          <a data-nav-guest href={`${base}hesap/kayit/`}>Kayıt ol</a>
          <a data-nav-member hidden href={`${base}hesap/`}>Hesabım</a>
        </>}
      </nav>
    </div>
  </header>

  
<slot />


  <footer class="cx-footer cx-footer--neural">
    <div class="cx-footer-neural">
      <span class="cx-footer-neural__node">COREXLYTH • NEURAL INTERFACE <i></i></span>
      <strong>EXPLORE <b>•</b> CREATE <b>•</b> EVOLVE</strong>
      <p>Fikirler <b>•</b> deneyimler <b>•</b> projeler</p>
      <small>Bağlantı kararlı • CoreXLyth</small>
      <nav class="cx-footer-links" aria-label="Ek bağlantılar"><a href={`${base}ara/`}>ARAMA</a><a href={`${base}arsiv/`}>ARŞİV</a><a href={`${base}rss.xml`}>RSS</a></nav>
    </div>
  </footer>

  <button class="cx-music-toggle" type="button" disabled title="Müzik oynatıcı ileride eklenecek" aria-label="Müzik oynatıcı yakında eklenecek">♫ MUSIC • <b>YAKINDA</b></button>

  <button class="cx-to-top" type="button" aria-label="Sayfanın başına dön">↑</button>

  <dialog class="cx-lightbox" aria-label="Görsel önizleme">
    <button class="cx-lightbox__close" type="button" aria-label="Görsel önizlemeyi kapat" autofocus>×</button>
    <figure>
      <img alt="" />
      <figcaption id="cx-lightbox-caption" aria-live="polite"></figcaption>
    </figure>
    <div class="cx-lightbox__controls">
      <button type="button" data-lightbox-prev aria-label="Önceki görsel">← Önceki</button>
      <span data-lightbox-count aria-live="polite"></span>
      <button type="button" data-lightbox-next aria-label="Sonraki görsel">Sonraki →</button>
    </div>
  </dialog>

<script>import '../scripts/navigation-auth'; import '../scripts/depth-city';</script>
<script is:inline src={`${base}assets/js/main.js?v=cyber-infrastructure-1`}></script>
</body>
</html>
