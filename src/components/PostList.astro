---
import type { Post } from '../lib/posts';
import { coverFor, dateTR, postUrl, categoryUrl } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
<div class="cx-record-list">
  {posts.map((post) => (
    <a class="cx-record-row" href={postUrl(post)}>
      <time class="cx-record-date" datetime={post.data.pubDate.toISOString().slice(0,10)}>{dateTR(post.data.pubDate)}</time>
      <span class="cx-record-copy">
        <b>{post.data.title}</b>
        <small>{post.data.description}</small>
      </span>
      <img src={coverFor(post)} alt="" loading="lazy" />
    </a>
  ))}
</div>
