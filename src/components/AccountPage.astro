---
import SiteLayout from '../layouts/SiteLayout.astro';
import Community from './Community.astro';
import { urlFor } from '../lib/posts';
import { authConfigured, authPublicLaunch } from '../config/auth';
import { MIN_PASSWORD_LENGTH, passwordChecks } from '../lib/auth-rules';
interface Props { mode: 'account' | 'login' | 'signup' | 'forgot' | 'reset' | 'confirm'; }
const { mode } = Astro.props;
const titles = { account:'Hesabım', login:'Giriş yap', signup:'Hesap oluştur', forgot:'Şifremi unuttum', reset:'Yeni şifre belirle', confirm:'E-posta doğrulama' };
const needsEmail = ['login','signup','forgot'].includes(mode);
const needsPassword = ['login','signup','reset'].includes(mode);
const newPassword = ['signup','reset'].includes(mode);
---
<SiteLayout title={`${titles[mode]} | CoreXLyth`} noindex={true}>
  <meta slot="head" name="referrer" content="no-referrer" />
  <main id="home" class="cx-reading-shell cx-account-surface">
    <section class="cx-account cx-hud-frame" data-auth-page={mode} data-base={urlFor('')}>
      <p class="cx-kicker">COREXLYTH // HESAP</p>
      <h1>{titles[mode]}</h1>
      {!authPublicLaunch && <p>Üyelik sistemi kapalı test aşamasında.</p>}
      <p id="cx-auth-status" role="status" aria-live="polite">{authConfigured ? 'Bağlantı kontrol ediliyor…' : 'Hesap sistemi henüz kullanıma açılmadı.'}</p>
      {['login','signup','forgot','reset'].includes(mode) && <form data-auth-form method="post">
        <fieldset disabled>
          {needsEmail && <label>E-posta adresi
            <input name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required aria-describedby="cx-email-help" />
          </label>}
          {needsEmail && <p id="cx-email-help" class="cx-field-hint" role="status" aria-live="polite">Yalnızca @gmail.com adresi kullan.</p>}
          {needsPassword && <label>{newPassword ? 'Yeni şifre' : 'Şifre'}
            <input name="password" type="password" autocomplete={newPassword ? 'new-password' : 'current-password'} minlength={newPassword ? MIN_PASSWORD_LENGTH : undefined} maxlength="128" required aria-describedby={newPassword ? 'cx-password-help' : undefined} />
          </label>}
          {newPassword && <>
            <div id="cx-password-help">
              <p>Bu site için farklı bir şifre seç. Aşağıdaki şartların tamamı gerekli.</p>
              <ul class="cx-password-rules" aria-label="Şifre şartları">
                {passwordChecks('').map(check => <li data-password-rule={check.id} data-valid="false">
                  <span data-rule-icon aria-hidden="true">○</span>
                  <span>{check.label}</span>
                  <small data-rule-state>Eksik</small>
                </li>)}
              </ul>
              <p class="cx-field-hint" data-password-progress role="status" aria-live="polite">5 şarttan 0 tanesi tamamlandı.</p>
            </div>
            <label>Şifreyi tekrar yaz
              <input name="confirmPassword" type="password" autocomplete="new-password" minlength={MIN_PASSWORD_LENGTH} maxlength="128" required aria-describedby="cx-confirm-help" />
            </label>
            <p id="cx-confirm-help" class="cx-field-hint" role="status" aria-live="polite">Şifreni iki alana da aynı şekilde yaz.</p>
          </>}
          <button type="submit">{mode === 'forgot' ? 'Yenileme bağlantısı gönder' : mode === 'reset' ? 'Şifreyi güncelle' : titles[mode]}</button>
        </fieldset>
      </form>}
      <div data-account-details hidden>
        <p>E-posta: <strong data-account-email></strong></p>
        <p data-account-verification></p>
        {mode === 'account' && <details class="cx-settings" data-account-settings>
          <summary>Hesap ayarları</summary>
          <p>E-posta ve şifreni buradan güncelleyebilirsin.</p>
          <form data-change-email><p>Mevcut e-posta adresin: <strong data-settings-email></strong></p><label>Yeni Gmail adresi <input name="newEmail" type="email" inputmode="email" autocomplete="email" maxlength="254" required /></label><p data-email-change-status role="status" aria-live="polite"></p><button type="submit">E-posta değişikliği iste</button></form>
          <form data-change-password><label>Yeni şifre <input name="newPassword" type="password" autocomplete="new-password" minlength={MIN_PASSWORD_LENGTH} maxlength="128" required /></label>
            <ul data-settings-password-rules aria-label="Yeni şifre şartları">{passwordChecks('').map(check=><li data-rule={check.id}>{check.label}</li>)}</ul>
            <label>Yeni şifreyi tekrar yaz <input name="newPasswordConfirm" type="password" autocomplete="new-password" minlength={MIN_PASSWORD_LENGTH} maxlength="128" required /></label>
            <p data-password-change-status role="status" aria-live="polite"></p><button type="submit">Şifreyi güncelle</button>
          </form>
        </details>}
        <button type="button" data-signout>Çıkış yap</button>
      </div>
      <nav class="cx-account-links" data-account-links hidden={['account','confirm'].includes(mode)} aria-label="Hesap işlemleri">
        {mode !== 'login' && <a href={urlFor('hesap/giris/')}>Giriş yap</a>}
        {mode !== 'signup' && <a href={urlFor('hesap/kayit/')}>Hesap oluştur</a>}
        {!['forgot','signup'].includes(mode) && <a href={urlFor('hesap/sifremi-unuttum/')}>Şifremi unuttum</a>}
        {mode !== 'signup' && <a href={urlFor('')}>Ana sayfa</a>}
      </nav>
      <noscript><style is:inline>.cx-account-links[hidden]{display:flex!important}</style><p>Hesap işlemleri için tarayıcında JavaScript açık olmalı. Yazıları giriş yapmadan okuyabilirsin.</p></noscript>
    </section>
    {['account','confirm'].includes(mode) && <Community mode="account" />}
  </main>
</SiteLayout>
<script>
  import '../scripts/auth';
</script>
