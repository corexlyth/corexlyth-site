---
import SiteLayout from '../layouts/SiteLayout.astro';
import { urlFor } from '../lib/posts';
import { authConfigured, authPublicLaunch } from '../config/auth';
interface Props { mode: 'account' | 'login' | 'signup' | 'forgot' | 'reset' | 'confirm'; }
const { mode } = Astro.props;
const titles = { account:'Hesabım', login:'Giriş yap', signup:'Hesap oluştur', forgot:'Şifremi unuttum', reset:'Yeni şifre belirle', confirm:'E-posta doğrulama' };
const needsEmail = ['login','signup','forgot'].includes(mode);
const needsPassword = ['login','signup','reset'].includes(mode);
const newPassword = ['signup','reset'].includes(mode);
---
<SiteLayout title={`${titles[mode]} | CoreXLyth`} noindex={true}>
  <meta slot="head" name="referrer" content="no-referrer" />
  <main id="home" class="cx-reading-shell">
    <section class="cx-account cx-hud-frame" data-auth-page={mode} data-base={urlFor('')}>
      <p class="cx-kicker">COREXLYTH // HESAP</p>
      <h1>{titles[mode]}</h1>
      {!authPublicLaunch && <p>Üyelik sistemi kapalı test aşamasında.</p>}
      <p id="cx-auth-status" role="status" aria-live="polite">{authConfigured ? 'Bağlantı kontrol ediliyor…' : 'Hesap sistemi henüz kullanıma açılmadı.'}</p>
      {['login','signup','forgot','reset'].includes(mode) && <form data-auth-form method="post">
        <fieldset disabled>
          {needsEmail && <label>E-posta adresi
            <input name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required />
          </label>}
          {needsPassword && <label>{newPassword ? 'Yeni şifre' : 'Şifre'}
            <input name="password" type="password" autocomplete={newPassword ? 'new-password' : 'current-password'} minlength={newPassword ? 12 : undefined} maxlength="128" required aria-describedby={newPassword ? 'cx-password-help' : undefined} />
          </label>}
          {newPassword && <>
            <p id="cx-password-help">En az 12 karakter kullan. Bu site için farklı bir şifre seç.</p>
            <label>Şifreyi tekrar yaz
              <input name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
            </label>
          </>}
          <button type="submit">{mode === 'forgot' ? 'Yenileme bağlantısı gönder' : mode === 'reset' ? 'Şifreyi güncelle' : titles[mode]}</button>
        </fieldset>
      </form>}
      <div data-account-details hidden>
        <p>E-posta: <strong data-account-email></strong></p>
        <p data-account-verification></p>
        <a href={urlFor('hesap/sifre-yenile/')}>Şifremi değiştir</a>
        <button type="button" data-signout>Çıkış yap</button>
      </div>
      <nav class="cx-account-links" aria-label="Hesap işlemleri">
        <a href={urlFor('hesap/giris/')}>Giriş yap</a>
        <a href={urlFor('hesap/kayit/')}>Hesap oluştur</a>
        <a href={urlFor('hesap/sifremi-unuttum/')}>Şifremi unuttum</a>
        <a href={urlFor('')}>Ana sayfa</a>
      </nav>
      <noscript><p>Hesap işlemleri için tarayıcında JavaScript açık olmalı. Yazıları giriş yapmadan okuyabilirsin.</p></noscript>
    </section>
  </main>
</SiteLayout>
<script>
  import '../scripts/auth';
</script>
